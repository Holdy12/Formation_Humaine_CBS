# Copier ce fichier en .env à la racine du projet et renseigner les valeurs.
# .env n'est jamais versionné : chaque poste et le serveur ont le leur.

# Accès MySQL / MariaDB
DB_HOST=localhost
DB_NAME=formation_humaine_db
DB_USER=
DB_PASS=

# Adresse à laquelle l'application est servie, sans barre finale
BASE_URL=http://localhost:8000

# Fuseau horaire de PHP et de la connexion MySQL
APP_TIMEZONE=Africa/Ndjamena
